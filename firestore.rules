rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'damrongthamlopburi.1567@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin();
    }

    // Executives roster
    match /executives/{executiveId} {
      // Anyone can view the provincial executives roster
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Schedules (วาระงาน)
    match /schedules/{scheduleId} {
      // Public read so citizens and provincial staff can view the official schedule
      allow read: if true;
      allow create, update, delete: if true;
    }

    // System Settings (การตั้งค่าระบบ)
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
